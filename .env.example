# BBS BFF 地址，仅供 Treble Node/SSR 服务使用。
BBS_BFF_URL=http://localhost:8001
# Redis 只供 Treble Node 保存 Bass 双 Token 会话，不能暴露到公网。
REDIS_URL=redis://:your-password@redis.dev.bass.local:31379/0
# 本地 Bass 仓库路径。Bass 与 Treble 相邻时无需设置。
# BASS_REPO=../Bass

# Treble Node 服务端口。
PORT=2324
# Vite 构建选项。
VITE_DROP_CONSOLE=false
VITE_COMPRESS=false
VITE_GLOB_APP_TITLE=摸鱼派
