# BBS BFF 地址，仅供 Treble Node/SSR 服务使用。
BBS_BFF_URL=http://localhost:8001
# 浏览器公开访问的社区地址；与 BFF 的 SITE_PUBLIC_URL 保持一致。
SITE_PUBLIC_URL=http://localhost:2324
# 浏览器直连的 realtime node 地址；生产环境应配置为可公开访问的负载均衡入口。
REALTIME_NODE_URL=http://localhost:8020
# Redis 只供 Treble Node 保存 Bass 双 Token 会话，不能暴露到公网。
REDIS_URL=redis://:your-password@redis.dev.bass.local:31379/0
# 本地 Bass 仓库路径。Bass 与 Treble 相邻时无需设置。
# BASS_REPO=../Bass

# Treble Node 服务端口。
PORT=2324
# Vite 构建选项。
VITE_DROP_CONSOLE=false
VITE_COMPRESS=false
VITE_GLOB_APP_TITLE=摸鱼派
